{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Khal OS",
  "colors": {
    "primary": "#D49355",
    "light": "#E0B079",
    "dark": "#A06F3E"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "decoration": "gradient"
  },
  "fonts": {
    "heading": {
      "family": "Geist"
    },
    "body": {
      "family": "Geist"
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "tabs": [
          {
            "tab": "Start with khal",
            "groups": [
              {
                "group": "Onboarding & access",
                "pages": [
                  "fde-start-here/access/overview",
                  "fde-start-here/access/engineer-guide",
                  "fde-engineer/khal-cli",
                  "fde-start-here/access/admin-guide",
                  "fde-start-here/access/troubleshooting"
                ]
              }
            ]
          }
        ]
      },
      {
        "language": "pt-BR",
        "tabs": [
          {
            "tab": "Comece com o khal",
            "groups": [
              {
                "group": "Onboarding e acesso",
                "pages": [
                  "pt-BR/fde-start-here/access/overview",
                  "pt-BR/fde-start-here/access/engineer-guide",
                  "pt-BR/fde-engineer/khal-cli",
                  "pt-BR/fde-start-here/access/admin-guide",
                  "pt-BR/fde-start-here/access/troubleshooting"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/fde-start-here/enrollment",
      "destination": "/fde-start-here/access/overview"
    },
    {
      "source": "/fde-start-here/ssh-access",
      "destination": "/fde-start-here/access/engineer-guide"
    }
  ],
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/khal-os/docs"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/khal-os"
    }
  }
}
